# Copy this file to .env and set DATABASE_URL for your local PostgreSQL 17 database.
# .env is gitignored: never commit real credentials.
#
# Homebrew on macOS (user = your macOS username, no password):
#   DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/fairshare?schema=public"
# Docker (postgres:17 image started with POSTGRES_PASSWORD=postgres):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fairshare?schema=public"
# If port 5432 is already used by another PostgreSQL server, run this one on another port (for example 5433).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/fairshare?schema=public"

# Signs the session cookie (JWT). Use a random string of at least 32 characters,
# for example the output of: openssl rand -base64 32
JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Google sign-in (optional locally; the button shows a friendly error until these are set).
# Create an OAuth client ID of type "Web application" in Google Cloud Console and add
# http://localhost:3000/api/v1/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Public base URL for the Google redirect URI. Defaults to the request's origin.
# APP_URL="http://localhost:3000"

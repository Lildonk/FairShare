// FairShare data model. Decisions behind each change from the blueprint:
// docs/FAIRSHARE_PRODUCT_SPEC.md#data-model-decisions
// CHECK constraints on money columns live in the migration SQL (Prisma schema cannot express them).

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Platform-wide role. ADMIN unlocks only /admin and /api/v1/admin/*; never set it from client input.
enum Role {
  MEMBER
  ADMIN
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  ITEMIZED
}

enum SettlementStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

/// What an AuditEvent records (#8). #11 adds GROUP_ARCHIVED with its own migration.
enum AuditAction {
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  EXPENSE_DISPUTED
  EXPENSE_UNDISPUTED
  SETTLEMENT_RECORDED
  SETTLEMENT_STATUS_CHANGED
}

model User {
  id                  String         @id @default(uuid())
  email               String         @unique
  /// Null for accounts that only sign in with Google.
  passwordHash        String?
  /// Google's stable account ID (the ID token's `sub`), set on first Google sign-in or when linked.
  googleSub           String?        @unique
  name                String
  role                Role           @default(MEMBER)
  memberships         GroupMember[]
  paidExpenses        Expense[]      @relation("ExpensePayer")
  splits              ExpenseSplit[]
  settlementsSent     Settlement[]   @relation("SettlementFrom")
  settlementsReceived Settlement[]   @relation("SettlementTo")
  auditEvents         AuditEvent[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  currency    String        @default("USD")
  inviteCode  String        @unique @default(uuid())
  isArchived  Boolean       @default(false)
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  auditEvents AuditEvent[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model GroupMember {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([userId, groupId])
  @@index([groupId])
}

model Expense {
  id          String         @id @default(uuid())
  groupId     String
  group       Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payerId     String
  /// Restrict: a user who paid an expense cannot be deleted, so other members' balances stay intact.
  payer       User           @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Restrict)
  title       String
  /// Total in integer cents, greater than 0.
  amountCents Int
  splitType   SplitType      @default(EQUAL)
  category    String         @default("General")
  isDisputed  Boolean        @default(false)
  receiptUrl  String?
  splits      ExpenseSplit[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([groupId, createdAt])
  @@index([payerId])
}

model ExpenseSplit {
  id           String  @id @default(uuid())
  expenseId    String
  expense      Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// This participant's share in integer cents (0 or more). Shares of one expense sum to its amountCents.
  owedCents    Int
  /// PERCENTAGE splits only: the share in basis points, 0 to 10000 (3333 = 33.33%).
  allocatedBps Int?

  @@unique([expenseId, userId])
  @@index([userId])
}

model Settlement {
  id          String           @id @default(uuid())
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUserId  String
  fromUser    User             @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId    String
  toUser      User             @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)
  /// Payment from fromUser to toUser in integer cents, greater than 0. The two users must differ.
  amountCents Int
  status      SettlementStatus @default(PENDING)
  notes       String?
  settledAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([groupId, status])
  @@index([fromUserId])
  @@index([toUserId])
}

/// One change to a group's financial history (#8). Append-only: a trigger in the migration SQL
/// rejects UPDATE, DELETE, and TRUNCATE. Only test cleanup may delete, by turning on
/// `fairshare.audit_maintenance` in its transaction. Write events with `recordAuditEvent`
/// (src/lib/db/audit-log.ts) in the same transaction as the change they describe.
model AuditEvent {
  id        String      @id @default(uuid())
  /// Restrict: a group with history is archived (#11), never deleted.
  groupId   String
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  /// Restrict: the user who made a change stays on record.
  actorId   String
  actor     User        @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action    AuditAction
  /// The expense or settlement the event is about. No foreign key, so the event outlives a deleted expense.
  entityId  String
  /// The record after the change (before it, for deletions). Amounts in integer cents.
  snapshot  Json
  createdAt DateTime    @default(now())

  @@index([groupId, createdAt])
  @@index([entityId])
}
